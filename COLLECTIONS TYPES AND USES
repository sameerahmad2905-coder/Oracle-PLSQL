----------------USING ASSOCIATIVE ARRAYRS------------



declare
TYPE T IS TABLE OF EMP%ROWTYPE INDEX BY PLS_INTEGER;
ENO T;
ROW_CNT NUMBER;
BEGIN
SELECT * BULK COLLECT INTO ENO FROM EMP WHERE DEPTNO=50;
FOR I IN ENO.FIRST..ENO.LAST
LOOP
DBMS_OUTPUT.PUT_LINE(ENO(I).ENAME|| ||ENO(I).EMPNO);--|| ||ENM(I));
END LOOP;
ROW_CNT := ENO.COUNT;
DBMS_OUTPUT.PUT_LINE(ROW_CNT);
END;
/



