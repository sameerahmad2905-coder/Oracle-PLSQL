------USING VARRAYS I.E. DECLARED NO OF VALUES...

DECLARE
CURSOR C_NAME IS SELECT ENAME FROM EMP;-- WHERE DEPTNO=50;

TYPE VARRAY_TYPE IS VARRAY(46) OF EMP.ENAME%TYPE;--EMP.ENAME%TYPE;
V_NAME VARRAY_TYPE := VARRAY_TYPE();

V_COUNTER INTEGER :=0;  ---INITIALIZING FROM 0

BEGIN

FOR NAME_REC IN C_NAME  LOOP          ---I - INDEX IN CURSOR DECLARED HAING THE NAME VALUE
V_COUNTER := V_COUNTER + 1;
V_NAME.EXTEND;
V_NAME(V_COUNTER) := NAME_REC.ENAME;        ---VALUE AT EVERY COLLECTION INDEX I.E. V_NAME(V_COUNTER) := NAME_REC.COL_NAME
DBMS_OUTPUT.PUT_LINE(V_NAME(V_COUNTER));
END LOOP;
END;
/
