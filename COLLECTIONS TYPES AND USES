🔹 4. COLLECTIONS + FORALL (BULK DML, MIDDLE GROUND)

	IF YOU NEED ROW-BY-ROW LOGIC BUT FASTER THAN CURSOR, USE COLLECTIONS.

	DECLARE
	   TYPE EMP_TAB IS TABLE OF EMP.EMPNO%TYPE;
	   V_EMPNOS EMP_TAB;

	BEGIN
	   -- BULK COLLECT EMPNOS
	   SELECT EMPNO BULK COLLECT INTO V_EMPNOS
	   FROM EMP WHERE DEPTNO = 20;

	   -- BULK UPDATE USING FORALL
	   FORALL I IN V_EMPNOS.FIRST .. V_EMPNOS.LAST
		  UPDATE EMP
		  SET SAL = SAL * 1.10
		  WHERE EMPNO = V_EMPNOS(I);

	   COMMIT;
	END;
	/


    DECLARE
    TYPE T IS TABLE OF EMPP%ROWTYPE INDEX BY PLS_INTEGER;
    REC T;
    
    BEGIN
    SELECT * BULK COLLECT INTO REC FROM EMPP;				----> * or SELECTED COLUMN NAMES ONLY LIKE EMPNO & ENAME AS IS OPTED HERE
    FOR I IN REC.FIRST..REC.LAST
    LOOP
    DBMS_OUTPUT.PUT_LINE(REC(I).EMPNO||- ||REC(I).ENAME);
    END LOOP;
    END;
    /
	
⚡ PROS: MUCH FASTER THAN NORMAL CURSORS.
⚡ CONS: MORE CODING COMPLEXITY.



🔹 5. RECORDS + COLLECTIONS + FORALL (BULK DML, MIDDLE GROUND)

DECLARE
  TYPE emp_rec IS RECORD (
    empno emp.empno%TYPE,
    ename emp.ename%TYPE
  );

  TYPE emp_tab IS TABLE OF emp_rec INDEX BY PLS_INTEGER;
  v_emp emp_tab;
BEGIN
  SELECT empno, ename
  BULK COLLECT INTO v_emp
  FROM emp;

  FOR i IN v_emp.FIRST .. v_emp.LAST LOOP
    DBMS_OUTPUT.PUT_LINE(v_emp(i).empno ||  -  || v_emp(i).ename);
  END LOOP;
END;
