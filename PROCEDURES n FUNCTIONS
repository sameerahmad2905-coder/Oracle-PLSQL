CREATE OR REPLACE FUNCTION SAL_RANGE(SAL IN NUMBER)
RETURN NUMBER IS
BEGIN
    IF SAL BETWEEN 18000 AND 30000 THEN
        RETURN 2;
    ELSIF SAL BETWEEN 9000 AND 18000 THEN
        RETURN 1;
    ELSE 
        RETURN 0;
    END IF;
END;
/

SELECT EMPNO, SAL, SAL_RANGE(SAL) AS RANGE FROM EMP;

DECLARE
    V_GRADE NUMBER;
BEGIN
    V_GRADE := SAL_RANGE(20000);
    DBMS_OUTPUT.PUT_LINE('Salary Grade: ' || V_GRADE);
END;
/




CREATE OR REPLACE FUNCTION FUNC_EMP (EID IN NUMBER)
RETURN VARCHAR2
AS
V_NAME EMP.ENAME%TYPE;
V_COUNT NUMBER;

NO_DATA EXCEPTION; 
DUP_ROWS EXCEPTION;
BEGIN
SELECT COUNT(EID) INTO V_COUNT FROM EMP WHERE EMPNO=EID;

    IF V_COUNT = 0 THEN
    RAISE NO_DATA;
    ELSIF V_COUNT > 1 THEN
    RAISE DUP_ROWS;
    END IF;

SELECT ENAME INTO V_NAME FROM EMP WHERE EMPNO=EID;
RETURN V_NAME;

EXCEPTION
WHEN NO_DATA THEN
RETURN 'NO RECORDS AVAILABEL';
WHEN DUP_ROWS THEN
RETURN 'DUPLICATE EMPNO';
END;
/



