CREATE OR REPLACE PROCEDURE PROC_EMP (E_ID IN NUMBER)
AS
    V_ENAME VARCHAR2(50);
    V_CELL VARCHAR2(30);
    
    -- DECLARE CUSTOM EXCEPTION
    employee_not_found_exception EXCEPTION;
    PRAGMA EXCEPTION_INIT(employee_not_found_exception, -20001);
    
       duplicate_values EXCEPTION;
    
    v_emp_count NUMBER;
BEGIN
    -- 1. Check if employee exists using COUNT
    SELECT COUNT(*)
    INTO v_emp_count
    FROM EMPLOYEES 
    WHERE EMPLOYEE_ID = E_ID;
    
    -- 2. RAISE custom exception if not found
    IF v_emp_count = 0 THEN
        RAISE employee_not_found_exception;
    END IF;
    
      IF v_emp_count > 1 THEN
        RAISE duplicate_values;
    END IF;
    
    -- 3. Fetch employee details
    SELECT FIRST_NAME||' '||LAST_NAME, PHONE_NUMBER 
    INTO V_ENAME, V_CELL 
    FROM EMPLOYEES 
    WHERE EMPLOYEE_ID = E_ID;
    
    -- 4. Process/display data
    DBMS_OUTPUT.PUT_LINE('Employee: ' || V_ENAME);
    DBMS_OUTPUT.PUT_LINE('Phone: ' || V_CELL);
    
EXCEPTION
    -- 5. HANDLE custom exception
    WHEN employee_not_found_exception THEN
        RAISE_APPLICATION_ERROR(-20001, 'Employee with ID ' || E_ID || ' not found');
    
        WHEN duplicate_values THEN
        RAISE_APPLICATION_ERROR(-20002, 'Duplicate values found');
    
    WHEN OTHERS THEN
        RAISE_APPLICATION_ERROR(-20002, 'Unexpected error: ' || SQLERRM);
END;
/

execute PROC_EMP(10);

DELETE FROM EMPLOYEES WHERE ROWID NOT IN (SELECT MAX(ROWID) FROM EMPLOYEES GROUP BY EMPLOYEE_ID)
AND EMPLOYEE_ID=101;


-----------------------------------------------------------FUNCTIONS---------------------------------------------

A FUNCTION is a named PL/SQL block that:

Returns a single value (mandatory)
Can accept zero or more parameters (optional)
Can be called from SQL statements and PL/SQL blocks
Performs calculations or transformations
Should ideally be free of side effects (no DML in pure functions)

👉 Functions can be called directly in SELECT, WHERE, and other SQL clauses:
👉 Functions can be used for Data Validation and Transformation
👉 Functions can be used in check constraints and triggers


👉 Being used for deoing calculations or transformations


CREATE OR REPLACE FUNCTION calc_bonus(p_salary NUMBER)
RETURN NUMBER IS
BEGIN
    RETURN p_salary * 0.10;
END;
/
-- View bonuses in query:
SELECT E.*, calc_bonus(SAL) FROM EMP E;

DECLARE
